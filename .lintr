linters: linters_with_defaults()
# One exclusion, and it is a roxygen constraint rather than a style
# choice: `@examplesIf` takes its condition from the FIRST LINE of the
# tag, so the condition cannot be wrapped, and appending `# nolint`
# makes roxygen report "mismatched braces or quotes" and drop the
# example block from the Rd (measured, session 37). The condition names
# the three packages that example needs — modelbased, rstanarm and
# marginaleffects — and is 82 characters.
exclusions: list("R/extract-draws.R" = list(line_length_linter = 74))
